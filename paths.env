# ------------------------------------------------------------------------------
# Workflow locations  (single source of truth)
#
# Edit these when your Zotero library, notes trees, research archives, website
# repo, or dotfiles checkout move. Fish and Neovim both read this file.
#
# Per-machine overrides can still win by exporting the same variable before the
# repo config loads (for example via `set -Ux VAR ...` in fish).
# ------------------------------------------------------------------------------

DOTFILES_DIR="$HOME/.dotfiles"
ZOTERO_LIBRARY_JSON="$HOME/Documents/Library/Library.json"
ZOTERO_LIBRARY_BIB="$HOME/Documents/Library/Library.bib"
READING_NOTES_DIR="$HOME/Notes/02 Notes/01 Reading Notes"
RESEARCH_NOTES_DIR="$HOME/Notes/02 Notes/02 Research Notes"
RESEARCH_ARCHIVES_DIR="$HOME/Notes/03 Research/Archives"
WEBSITE_REPO="$HOME/git/website"
