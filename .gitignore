.DS_Store
bin/__pycache__/
# Compiled spell binary — regenerated by nvim from the tracked .add wordlist
writing/nvim/spell/*.add.spl
# Byte-compiled elisp / yasnippet cache — regenerated by Emacs; straight.el's
# own downloaded package repos live outside the repo (init.el sets
# straight-base-dir to XDG_DATA_HOME) so they never reach this list
writing/emacs/**/*.elc
writing/emacs/snippets/.yas-compiled-snippets.el
