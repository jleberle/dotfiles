#!/usr/bin/env python3

"""
Save a URL to the Internet Archive Wayback Machine.

Usage:
    waybackup <URL>

Prints the archived snapshot URL on success.
"""

from __future__ import annotations

import json
import socket
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

WAYBACK_SAVE_PREFIX = "https://web.archive.org/save/"
WAYBACK_AVAILABILITY_API = "https://archive.org/wayback/available"

HEADERS = {
    "User-Agent": "Mozilla/5.0 (compatible; waybackup/1.0)",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
}


def validate_url(url: str) -> bool:
    parsed = urllib.parse.urlparse(url)
    return parsed.scheme in {"http", "https"} and bool(parsed.netloc)


def fetch(url: str, timeout: float) -> tuple[str, "email.message.Message", bytes]:
    request = urllib.request.Request(url, headers=HEADERS)
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.geturl(), response.headers, response.read()


def extract_snapshot_url(final_url: str, headers, body: bytes) -> str | None:
    # Final redirected URL
    if final_url.startswith("https://web.archive.org/web/"):
        return final_url

    # Standard Wayback header
    content_location = headers.get("Content-Location")
    if content_location:
        return "https://web.archive.org" + content_location

    # Redirect header
    location = headers.get("Location")
    if location:
        if location.startswith("http"):
            return location
        return "https://web.archive.org" + location

    return None


def poll_availability(target: str, after_timestamp: str) -> str | None:
    """Poll the availability API for a snapshot saved at or after after_timestamp."""
    query = urllib.parse.urlencode({"url": target, "timestamp": after_timestamp})
    _, _, body = fetch(f"{WAYBACK_AVAILABILITY_API}?{query}", timeout=30)
    data = json.loads(body)
    snapshot = data.get("archived_snapshots", {}).get("closest", {})
    if snapshot.get("available") and snapshot.get("url"):
        return snapshot["url"]
    return None


def save_url(target: str) -> str:
    submit_url = WAYBACK_SAVE_PREFIX + urllib.parse.quote(target, safe="")

    # Capture before submitting so any snapshot created during the request is
    # not missed by the availability poll.
    after_timestamp = time.strftime("%Y%m%d%H%M%S", time.gmtime())

    final_url, headers, body = fetch(submit_url, timeout=120)

    snapshot = extract_snapshot_url(final_url, headers, body)
    if snapshot:
        return snapshot

    # Archive processing can be delayed. Poll the availability API (read-only)
    # rather than re-submitting the save request repeatedly.
    for attempt in range(15):
        time.sleep(2 * (attempt + 1))  # gentle backoff: 2s, 4s, 6s, …

        snapshot = poll_availability(target, after_timestamp)
        if snapshot:
            return snapshot

    # Last-ditch fallback: search the original response body for a snapshot URL.
    text = body.decode("utf-8", errors="replace")
    marker = "https://web.archive.org/web/"
    idx = text.find(marker)
    if idx != -1:
        end = text.find('"', idx)
        if end != -1:
            return text[idx:end]

    raise RuntimeError("Could not determine snapshot URL")


def main() -> int:
    if len(sys.argv) != 2:
        print("Usage: waybackup <URL>", file=sys.stderr)
        return 2

    target = sys.argv[1]

    if not validate_url(target):
        print("Invalid URL", file=sys.stderr)
        return 2

    try:
        snapshot = save_url(target)

    except socket.timeout:
        print("Request timed out", file=sys.stderr)
        return 1

    except urllib.error.HTTPError as e:
        print(f"HTTP error: {e.code}", file=sys.stderr)
        return 1

    except urllib.error.URLError as e:
        print(f"Request failed: {e.reason}", file=sys.stderr)
        return 1

    except RuntimeError as e:
        print(str(e), file=sys.stderr)
        return 1

    print(snapshot)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
