#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["requests"]
# ///

# Usage: waybackup <URL>
# Saves the URL to the Wayback Machine and prints the snapshot URL.

import sys
import requests

base_url = 'https://web.archive.org'


def main():
    if len(sys.argv) != 2:
        print('Usage: waybackup <URL>', file=sys.stderr)
        return 2

    target = sys.argv[1]

    try:
        r = requests.get(base_url + '/save/' + target, timeout=60)
    except requests.RequestException as e:
        print('Request failed: ' + str(e), file=sys.stderr)
        return 1

    if r.status_code == requests.codes.ok:
        location = r.headers.get('content-location')
        if location:
            print(base_url + location)
            return 0
        # Save succeeded but no snapshot path was returned; fall back to the
        # original URL so the caller still has something usable.
        print(target)
        return 0

    print('Error in response: ' + str(r.status_code), file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
