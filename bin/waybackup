#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["requests"]
# ///

"""
Save a URL to the Internet Archive Wayback Machine.

Usage:
    waybackup <URL>

Prints the archived snapshot URL on success.
"""

from __future__ import annotations

import sys
import time
from urllib.parse import quote, urlparse

import requests

WAYBACK_SAVE_PREFIX = "https://web.archive.org/save/"
WAYBACK_AVAILABILITY_API = "https://archive.org/wayback/available"


def validate_url(url: str) -> bool:
    parsed = urlparse(url)
    return parsed.scheme in {"http", "https"} and bool(parsed.netloc)


def extract_snapshot_url(response: requests.Response) -> str | None:
    # Final redirected URL
    if response.url.startswith("https://web.archive.org/web/"):
        return response.url

    # Standard Wayback header
    content_location = response.headers.get("Content-Location")
    if content_location:
        return "https://web.archive.org" + content_location

    # Redirect header
    location = response.headers.get("Location")
    if location:
        if location.startswith("http"):
            return location
        return "https://web.archive.org" + location

    return None


def poll_availability(session: requests.Session, target: str, after_timestamp: str) -> str | None:
    """Poll the availability API for a snapshot saved at or after after_timestamp."""
    resp = session.get(
        WAYBACK_AVAILABILITY_API,
        params={"url": target, "timestamp": after_timestamp},
        timeout=30,
    )
    resp.raise_for_status()
    data = resp.json()
    snapshot = data.get("archived_snapshots", {}).get("closest", {})
    if snapshot.get("available") and snapshot.get("url"):
        return snapshot["url"]
    return None


def save_url(session: requests.Session, target: str) -> str:
    submit_url = WAYBACK_SAVE_PREFIX + quote(target, safe="")

    # Capture before submitting so any snapshot created during the request is
    # not missed by the availability poll.
    after_timestamp = time.strftime("%Y%m%d%H%M%S", time.gmtime())

    response = session.get(
        submit_url,
        allow_redirects=True,
        timeout=120,
    )

    response.raise_for_status()

    snapshot = extract_snapshot_url(response)
    if snapshot:
        return snapshot

    # Archive processing can be delayed. Poll the availability API (read-only)
    # rather than re-submitting the save request repeatedly.
    for attempt in range(15):
        time.sleep(2 * (attempt + 1))  # gentle backoff: 2s, 4s, 6s, …

        snapshot = poll_availability(session, target, after_timestamp)
        if snapshot:
            return snapshot

    # Last-ditch fallback: search the original response body for a snapshot URL.
    text = response.text
    marker = "https://web.archive.org/web/"
    idx = text.find(marker)
    if idx != -1:
        end = text.find('"', idx)
        if end != -1:
            return text[idx:end]

    raise RuntimeError("Could not determine snapshot URL")


def main() -> int:
    if len(sys.argv) != 2:
        print("Usage: waybackup <URL>", file=sys.stderr)
        return 2

    target = sys.argv[1]

    if not validate_url(target):
        print("Invalid URL", file=sys.stderr)
        return 2

    session = requests.Session()

    session.headers.update(
        {
            "User-Agent": (
                "Mozilla/5.0 (compatible; waybackup/1.0)"
            ),
            "Accept": (
                "text/html,application/xhtml+xml,"
                "application/xml;q=0.9,*/*;q=0.8"
            ),
        }
    )

    try:
        snapshot = save_url(session, target)

    except requests.Timeout:
        print("Request timed out", file=sys.stderr)
        return 1

    except requests.HTTPError as e:
        status = (
            e.response.status_code
            if e.response is not None
            else "unknown"
        )
        print(f"HTTP error: {status}", file=sys.stderr)
        return 1

    except requests.RequestException as e:
        print(f"Request failed: {e}", file=sys.stderr)
        return 1

    except RuntimeError as e:
        print(str(e), file=sys.stderr)
        return 1

    print(snapshot)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())