<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: __HOMEBREW_PREFIX__ and __HOME__ are replaced by `make resticcheck`.
     Runs `arch backup check` via fish so it inherits the ARCHIVE_RESTIC_REPO /
     RESTIC_PASSWORD_FILE universal variables (any fish process loads them); the
     function itself exits quietly when the external drive isn't mounted.

     The `echo` prefix stamps each run. Without it this log was the only one of
     the three that could not answer its own question: it held seven identical
     "skipping check" lines and no dates, so there was no way to tell whether
     the backup had last been verified a week ago or in March -- on the log
     whose entire purpose is turning "I have backups" into "I have RESTORABLE
     backups". mailsync.sh and homebrewupdate.sh both stamp every run. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.jaredeberle.resticcheck</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOMEBREW_PREFIX__/bin/fish</string>
        <string>-c</string>
        <string>echo &quot;=== &quot;(date &quot;+%Y-%m-%d %H:%M:%S&quot;)&quot; ===&quot;; arch backup check</string>
    </array>

    <!-- Weekly: Sunday 10:00; runs on next wake if the Mac was asleep. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>10</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.local/restic_check_logs.txt</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/restic_check_logs.txt</string>
</dict>
</plist>
