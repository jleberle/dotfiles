				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}
	-- Capture the frontmost Safari page's URL, guarding the cases that
	-- otherwise leave us launching Firefox with no URL (Safari not running,
	-- or its front window isn't a normal browsing window).
	if not (application "Safari" is running) then return input
	tell application "Safari"
		if (count of documents) is 0 then return input
		set theURL to URL of front document
	end tell
	if theURL is missing value or theURL is "" then return input

	if application "Firefox" is running then
		-- Already up: hand off via LaunchServices, which reliably opens a new
		-- tab in the running instance. No startup modifier check happens, so
		-- the activating hotkey's Option key cannot trigger Troubleshoot Mode.
		do shell script "open -a Firefox " &amp; quoted form of theURL
	else
		-- Cold start: launch the binary directly so MOZ_DISABLE_SAFE_MODE_KEY
		-- takes effect (Option held by the hotkey would otherwise trigger
		-- Troubleshoot/safe mode). -new-tab makes the URL survive session
		-- restore, which a bare positional URL intermittently does not.
		do shell script "MOZ_DISABLE_SAFE_MODE_KEY=1 /Applications/Firefox.app/Contents/MacOS/firefox -new-tab " &amp; quoted form of theURL &amp; " &gt; /dev/null 2&gt;&amp;1 &amp;"
	end if
	return input
end run</string>
				</dict>
				<key>BundleIdentifier</key>
				<string>com.apple.Automator.RunScript</string>
				<key>CFBundleVersion</key>
				<string>1.0.2</string>
