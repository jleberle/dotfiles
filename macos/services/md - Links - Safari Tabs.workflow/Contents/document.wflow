				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># grabs safari tabs
# creates markdown reference list
# generates unique, short titles based on domains
# truncates feedburner stuff

UNICODE_COMPETENT = ((RUBY_VERSION)[0..2].to_f &gt; 1.8)

unless UNICODE_COMPETENT # lower than 1.9
  class String
     def utf8_length
        i = 0
        i = self.scan(/(.)/).length
        i
     end
  end
else # 1.9 and above
  class String
     alias_method :utf8_length, :length
  end
end

def clean_query(url)
  query = url.match(/\?.*/)
  if query
    query = query[0]
    new_query = query.gsub(/[\?&amp;](utm_[^=]+|ref)=.*?(?=&amp;|$)/,'')
    if new_query.length &gt; 0 &amp;&amp; new_query =~ /^&amp;/
      new_query.sub!(/^&amp;/,'?')
    end
    url.sub!(/#{Regexp.escape(query)}/, new_query)
  end
  url
end

def safari_refs
  urllist = %x{osascript &lt;&lt;-APPLESCRIPT
  tell application "Safari"
    set tabList to every tab of window 1
    set urlList to ""
    repeat with aTab in tabList
      set aLink to URL of aTab as string &amp; ASCII character 10
      set urlList to urlList &amp; aLink
    end repeat
  return urlList
  end tell
  APPLESCRIPT }.strip
  unless urllist.length &gt; 0
    exit
  end

  links = urllist.split(/\n/)

  norepeat = []
  output = []
  links.each {|url|
    next if url =~ /workona.com\/\d\//
    url = clean_query(url)

      if url =~ (/http:\/\/itunes.apple.com\/(.+?)\/app\/(.+?)\/id\d+/)
        name = $2
      elsif url =~ /(itunes|phobos).apple.com/
        name = "itunes"
      else
        domain = url.match(/https?:\/\/([^\/]+)/)
        parts = domain[1].split('.')
        name = case parts.length
          when 1
          when 2
            parts[0]
          else
            parts[1]
        end
      end

    while norepeat.include? name
      if name =~ / ?[0-9]$/
        name.next!
      else
        name = name + " 2"
      end
    end
    output &lt;&lt; {'title' =&gt; name, 'link' =&gt; url }
    norepeat.push name
  }
  output = output.sort {|a,b| a['title'] &lt;=&gt; b['title']}
  counter = 0
  output.each { |x|
    counter += 1
    puts "[#{x['title']}]: #{x['link']}"
  }
end

safari_refs</string>
