Host codeberg
  User git
  HostName codeberg.org
  IdentityFile ~/.ssh/id_codeberg
  UseKeychain yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPersist 10m
  ControlPath ~/.ssh/control/%C

Host github
  User git
  HostName github.com
  IdentityFile ~/.ssh/id_github
  UseKeychain yes
  AddKeysToAgent yes

# Fallback: use port 443 if port 22 is blocked (e.g. restrictive networks)
# Usage: git remote set-url origin git@github-443:user/repo.git
Host github-443
  User git
  HostName ssh.github.com
  Port 443
  IdentityFile ~/.ssh/id_github
  UseKeychain yes
  AddKeysToAgent yes

Host *
    # Modern identity handling
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

    # Safer host verification
    StrictHostKeyChecking yes
    VerifyHostKeyDNS no
    HashKnownHosts yes
    UserKnownHostsFile ~/.ssh/known_hosts

    # Prevent accidental credential leakage
    ForwardAgent no
    ForwardX11 no

    # Session reliability
    # ServerAliveInterval sends keepalives to all hosts — intentional, prevents
    # idle disconnects on long-running sessions (tmux, remote editors, etc.)
    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive no

    # Modern crypto
    KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

    # Privacy / noise reduction
    Compression no
    GSSAPIAuthentication no

    # Logging
    LogLevel INFO

