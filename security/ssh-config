Host codeberg
  User git
  HostName codeberg.org
  IdentityFile ~/.ssh/secretive_codeberg.pub
  UseKeychain yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPersist 10m
  ControlPath ~/.ssh/control/%C

Host github
  User git
  HostName github.com
  IdentityFile ~/.ssh/secretive_github.pub
  UseKeychain yes
  AddKeysToAgent yes

# Fallback: use port 443 if port 22 is blocked (e.g. restrictive networks)
# Usage: git remote set-url origin git@github-443:user/repo.git
Host github-443
  User git
  HostName ssh.github.com
  Port 443
  IdentityFile ~/.ssh/secretive_github.pub
  UseKeychain yes
  AddKeysToAgent yes

Host *
    # Modern identity handling
    IdentitiesOnly yes

    # Safer host verification. Two known_hosts files: the writable one collects
    # new hosts as usual; known_hosts_pinned (symlinked from security/known_hosts
    # by `make security`) pre-trusts GitHub/Codeberg so there's no trust-on-first-
    # use prompt — or MITM window — on a fresh machine.
    StrictHostKeyChecking yes
    VerifyHostKeyDNS no
    HashKnownHosts yes
    UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts_pinned

    # Prevent accidental credential leakage
    ForwardAgent no
    ForwardX11 no

    # Session reliability
    # ServerAliveInterval sends keepalives to all hosts — intentional, prevents
    # idle disconnects on long-running sessions (tmux, remote editors, etc.)
    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive no

    # Modern crypto — hybrid post-quantum kex first (OpenSSH 9.x/10.x defaults),
    # classical curve25519 as the floor for older servers.
    KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,curve25519-sha256,curve25519-sha256@libssh.org
    # AEAD-only, 256-bit. AES-256-GCM preferred: ChaCha20-Poly1305 was the
    # cipher affected by Terrapin (CVE-2023-48795); kept second for servers
    # without AES hardware acceleration.
    Ciphers aes256-gcm@openssh.com,chacha20-poly1305@openssh.com
    # Only used if a non-AEAD cipher were ever negotiated (GCM/ChaCha carry
    # their own authentication); encrypt-then-MAC variants only.
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
    # Refuse weak/legacy authentication keys. Ed25519 preferred; RSA only with
    # SHA-2 signatures (no ssh-rsa/SHA-1) and ≥3072-bit. GitHub and Codeberg both
    # satisfy this; the floor only bites against outdated/misconfigured servers.
    PubkeyAcceptedAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256
    HostKeyAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256
    RequiredRSASize 3072

    # Privacy / noise reduction
    Compression no
    GSSAPIAuthentication no

    # Logging
    LogLevel INFO

    # --- Optional: Secure Enclave–backed keys (Secretive) -----------------------
    # The cask is in the Brewfile. Secretive keys are GENERATED inside the Secure
    # Enclave and never leave it: you cannot import id_github/id_codeberg — you
    # create NEW keys, and because the key is bound to one Mac's enclave it can't
    # sync, so EACH machine (Leia, Ahsoka) needs its own key registered separately.
    #
    # Migration gotcha: this config sets `IdentitiesOnly yes`, so ssh uses only the
    # key named by IdentityFile. Just adding IdentityAgent is NOT enough — ssh would
    # keep using the on-disk file. You must also repoint each host's IdentityFile at
    # the Secretive PUBLIC key. Use a stable path each machine fills with its own
    # pubkey (not secret, kept out of the repo); register every machine's pubkey
    # with the provider.
    #
    # Per machine, once: create keys in Secretive → export each public key to
    # ~/.ssh/secretive_github.pub and ~/.ssh/secretive_codeberg.pub → add them to
    # GitHub/Codeberg → `ssh -T git@github` to verify → then remove the old keys
    # from the providers and disk. To switch over, uncomment IdentityAgent here and
    # change the per-host `IdentityFile ~/.ssh/id_<host>` to the matching
    # `~/.ssh/secretive_<host>.pub`. Left off by default so on-disk keys keep working.
IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh

