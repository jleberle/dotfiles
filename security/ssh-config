Host codeberg
  User git
  HostName codeberg.org
  IdentityFile ~/.ssh/secretive_codeberg.pub
  UseKeychain yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPersist 10m
  ControlPath ~/.ssh/control/%C

Host github
  User git
  HostName github.com
  IdentityFile ~/.ssh/secretive_github.pub
  UseKeychain yes
  AddKeysToAgent yes

# Fallback: use port 443 if port 22 is blocked (e.g. restrictive networks)
# Usage: git remote set-url origin git@github-443:user/repo.git
Host github-443
  User git
  HostName ssh.github.com
  Port 443
  IdentityFile ~/.ssh/secretive_github.pub
  UseKeychain yes
  AddKeysToAgent yes

Host *
    # Modern identity handling
    IdentitiesOnly yes

    # Safer host verification. Two known_hosts files: the writable one collects
    # new hosts as usual; known_hosts_pinned (symlinked from security/known_hosts
    # by `make security`) pre-trusts GitHub/Codeberg so there's no trust-on-first-
    # use prompt — or MITM window — on a fresh machine.
    StrictHostKeyChecking yes
    VerifyHostKeyDNS no
    HashKnownHosts yes
    UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts_pinned

    # Prevent accidental credential leakage
    ForwardAgent no
    ForwardX11 no

    # Session reliability
    # ServerAliveInterval sends keepalives to all hosts — intentional, prevents
    # idle disconnects on long-running sessions (tmux, remote editors, etc.)
    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive no

    # Modern crypto — hybrid post-quantum kex first (OpenSSH 9.x/10.x defaults),
    # classical curve25519 as the floor for older servers.
    KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,curve25519-sha256,curve25519-sha256@libssh.org
    # AEAD-only, 256-bit. AES-256-GCM preferred: ChaCha20-Poly1305 was the
    # cipher affected by Terrapin (CVE-2023-48795); kept second for servers
    # without AES hardware acceleration.
    Ciphers aes256-gcm@openssh.com,chacha20-poly1305@openssh.com
    # Only used if a non-AEAD cipher were ever negotiated (GCM/ChaCha carry
    # their own authentication); encrypt-then-MAC variants only.
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
    # Refuse weak/legacy authentication keys. Ed25519 preferred; ECDSA P-256 is
    # included because Secretive (Secure Enclave) keys are necessarily P-256 — the
    # only curve the enclave supports; RSA only with SHA-2 signatures (no
    # ssh-rsa/SHA-1) and ≥3072-bit. The floor still excludes ssh-rsa/SHA-1, DSA,
    # and short RSA. GitHub and Codeberg satisfy all of these.
    PubkeyAcceptedAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com,ecdsa-sha2-nistp256,sk-ecdsa-sha2-nistp256@openssh.com,rsa-sha2-512,rsa-sha2-256
    HostKeyAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256
    RequiredRSASize 3072

    # Privacy / noise reduction
    Compression no
    GSSAPIAuthentication no

    # Logging
    LogLevel INFO

    # --- Secure Enclave–backed keys (Secretive) ---------------------------------
    # Live: each host block above already points IdentityFile at the Secretive
    # PUBLIC key (secretive_github.pub / secretive_codeberg.pub), and this
    # IdentityAgent line is active — the old id_github/id_codeberg on-disk
    # private keys are no longer used for auth (ssh-config sets `IdentitiesOnly
    # yes`, so only the named IdentityFile is offered).
    #
    # Secretive keys are GENERATED inside the Secure Enclave and never leave
    # it — you cannot import id_github/id_codeberg into it, and because a key
    # is bound to one Mac's enclave it can't sync, so a NEW machine needs its
    # own key generated and registered separately:
    # create a key in Secretive → export the public key to
    # ~/.ssh/secretive_github.pub and ~/.ssh/secretive_codeberg.pub → add them
    # to GitHub/Codeberg → `ssh -T git@github` to verify.
IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh

