Host codeberg
  User git
  HostName codeberg.org
  IdentityFile ~/.ssh/id_codeberg
  UseKeychain yes
  AddKeysToAgent yes
  ControlMaster auto
  ControlPersist 10m
  ControlPath ~/.ssh/control/%C

Host github
  User git
  HostName github.com
  IdentityFile ~/.ssh/id_github
  UseKeychain yes
  AddKeysToAgent yes

# Fallback: use port 443 if port 22 is blocked (e.g. restrictive networks)
# Usage: git remote set-url origin git@github-443:user/repo.git
Host github-443
  User git
  HostName ssh.github.com
  Port 443
  IdentityFile ~/.ssh/id_github
  UseKeychain yes
  AddKeysToAgent yes

Host *
    # Modern identity handling
    IdentitiesOnly yes

    # Safer host verification
    StrictHostKeyChecking yes
    VerifyHostKeyDNS no
    HashKnownHosts yes
    UserKnownHostsFile ~/.ssh/known_hosts

    # Prevent accidental credential leakage
    ForwardAgent no
    ForwardX11 no

    # Session reliability
    # ServerAliveInterval sends keepalives to all hosts — intentional, prevents
    # idle disconnects on long-running sessions (tmux, remote editors, etc.)
    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive no

    # Modern crypto — hybrid post-quantum kex first (OpenSSH 9.x/10.x defaults),
    # classical curve25519 as the floor for older servers.
    KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,curve25519-sha256,curve25519-sha256@libssh.org
    # AEAD-only, 256-bit. AES-256-GCM preferred: ChaCha20-Poly1305 was the
    # cipher affected by Terrapin (CVE-2023-48795); kept second for servers
    # without AES hardware acceleration.
    Ciphers aes256-gcm@openssh.com,chacha20-poly1305@openssh.com
    # Only used if a non-AEAD cipher were ever negotiated (GCM/ChaCha carry
    # their own authentication); encrypt-then-MAC variants only.
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
    # Refuse weak/legacy authentication keys. Ed25519 preferred; RSA only with
    # SHA-2 signatures (no ssh-rsa/SHA-1) and ≥3072-bit. GitHub and Codeberg both
    # satisfy this; the floor only bites against outdated/misconfigured servers.
    PubkeyAcceptedAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256
    HostKeyAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256
    RequiredRSASize 3072

    # Privacy / noise reduction
    Compression no
    GSSAPIAuthentication no

    # Logging
    LogLevel INFO

