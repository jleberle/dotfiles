# ──────────────────────────────────────────────────────────────────────────────
# NeoMutt account configuration template
#
# Copy this file to ~/.config/neomutt/accounts/local.rc and fill in your
# details. That path is NOT tracked by git (credentials are sensitive).
#
# Passwords — store in Keychain using a custom service name so the entry does
# not conflict with Apple Mail's OAuth tokens (which are stored under the actual
# server hostnames and will be returned instead of your app-specific password):
#
#   read -s -P "IMAP password: " PASS
#   security add-internet-password -s "neomutt-imap" -a "neomutt" \
#     -T /usr/bin/security -w $PASS
#
#   read -s -P "SMTP password: " PASS
#   security add-internet-password -s "neomutt-smtp" -a "neomutt" \
#     -T /usr/bin/security -w $PASS
#
# Then reference them as shown below. The -T flag allows /usr/bin/security to
# read the entry without a Keychain prompt.
#
# iCloud Mail servers (custom domain or @icloud.com):
#   IMAP: imap.mail.me.com:993   SMTP: smtp.mail.me.com:587
#   Requires an app-specific password from appleid.apple.com
# ──────────────────────────────────────────────────────────────────────────────

# Identity
set realname = "Your Name"
set from     = "you@example.com"

# IMAP
set folder    = "imaps://imap.example.com/"
set imap_user = "you@example.com"
set imap_pass = `security find-internet-password -s "neomutt-imap" -a "neomutt" -w 2>/dev/null | tr -d '\n'`

# Default mailboxes
set spoolfile = +INBOX
set record    = +Sent
set trash     = +Trash
set postponed = +Drafts
mailboxes =INBOX =Sent =Drafts =Trash =Archive

# SMTP (encode @ in username as %40)
set smtp_url  = "smtp://you%40example.com@smtp.example.com:587/"
set smtp_pass = `security find-internet-password -s "neomutt-smtp" -a "neomutt" -w 2>/dev/null | tr -d '\n'`

# TLS
set ssl_starttls  = yes
set ssl_force_tls = yes

# iCloud-specific (uncomment if using iCloud Mail)
# set imap_idle             = no
# set imap_check_subscribed = no
