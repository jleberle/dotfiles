# ──────────────────────────────────────────────────────────────────────────────
# NeoMutt — Nord color scheme
#
# Ghostty Nord theme ANSI palette (color0–15):
#   color0  = #3B4252  Polar Night 1
#   color1  = #BF616A  Aurora red
#   color2  = #A3BE8C  Aurora green
#   color3  = #EBCB8B  Aurora yellow
#   color4  = #81A1C1  Frost blue
#   color5  = #B48EAD  Aurora purple
#   color6  = #88C0D0  Frost cyan
#   color7  = #E5E9F0  Snow Storm
#   color8  = #4C566A  Polar Night 3 (bright black)
#   color9  = #BF616A  Aurora red (bright)
#   color10 = #A3BE8C  Aurora green (bright)
#   color11 = #EBCB8B  Aurora yellow (bright)
#   color12 = #81A1C1  Frost blue (bright)
#   color13 = #B48EAD  Aurora purple (bright)
#   color14 = #88C0D0  Frost cyan (bright)
#   color15 = #ECEFF4  Snow Storm bright
# ──────────────────────────────────────────────────────────────────────────────

# ── Chrome (bars and UI) ───────────────────────────────────────────────────────
color status            color6  color0    # Frost cyan on Polar Night 1
color indicator         color15 color8    # Snow Storm bright on Polar Night 3
color sidebar_divider   color8  default
color sidebar_highlight color15 color8
color sidebar_new       color6  default   # Frost cyan
color sidebar_flagged   color3  default   # Aurora yellow

# ── Base ───────────────────────────────────────────────────────────────────────
color normal     color7  default          # Snow Storm on terminal bg
color error      color1  default          # Aurora red
color message    color6  default          # Frost cyan
color tilde      color8  default          # Polar Night 3 (empty line fill)
color markers    color1  default          # Aurora red (line-wrap marker)
color search     color0  color3           # Polar Night on Aurora yellow
color attachment color3  default          # Aurora yellow

# ── Index — message states ─────────────────────────────────────────────────────
color index  color15 default  "~N"        # new      — Snow Storm bright
color index  color3  default  "~F"        # flagged  — Aurora yellow
color index  color1  default  "~D"        # deleted  — Aurora red
color index  color2  default  "~Q"        # replied  — Aurora green
color index  color6  default  "~T"        # tagged   — Frost cyan

# ── Index — crypto ─────────────────────────────────────────────────────────────
color index  color2  default  "~g"        # PGP signed    — Aurora green
color index  color2  default  "~G"        # PGP encrypted — Aurora green

# ── Threading tree ─────────────────────────────────────────────────────────────
color tree   color4  default              # Frost blue

# ── Pager — quoted levels ──────────────────────────────────────────────────────
color quoted   color2  default            # Aurora green
color quoted1  color6  default            # Frost cyan
color quoted2  color3  default            # Aurora yellow
color quoted3  color5  default            # Aurora purple
color quoted4  color4  default            # Frost blue

# ── Pager — signature ──────────────────────────────────────────────────────────
color signature  color8  default          # Polar Night 3 (muted)

# ── Headers ────────────────────────────────────────────────────────────────────
color hdrdefault  color4   default
color header      color6   default  "^(From|To|Cc|Bcc):"   # Frost cyan
color header      color15  default  "^Subject:"             # Snow Storm bright
color header      color8   default  "^Date:"                # Polar Night 3 (muted)
color header      color1   default  "^X-Spam"               # Aurora red

# ── Body — URLs and addresses ──────────────────────────────────────────────────
color body  color6  default  "(https?|ftp)://[[:alnum:]/_:;?&=.#@%~,!+-]+"
color body  color6  default  "[[:alnum:].+-]+@[[:alnum:]_-]+\\.[[:alnum:].]+"

# ── Body — PGP blocks ──────────────────────────────────────────────────────────
color body  color2  default  "^-----BEGIN PGP.*"
color body  color2  default  "^-----END PGP.*"
color body  color2  default  "^gpg: "
