# Template — __HOME__ is replaced with $(HOME) by `make neomutt`
# (notmuch does not expand ~ or env vars in database.path).
[database]
path=__HOME__/.mail

[user]
name=Your Name
primary_email=you@yourdomain.com
other_email=you@proton.me;

[new]
tags=unread;inbox;
ignore=.mbsyncstate;.uidvalidity;

[search]
exclude_tags=deleted;spam;

[maildir]
synchronize_flags=true
