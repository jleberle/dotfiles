<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: __HOME__ is replaced with $(HOME) by `make decksync`.
     Unlike the other agents here, this one is WatchPaths-triggered rather
     than calendar/interval: it fires whenever anything under /Volumes
     changes (a drive mounting or unmounting), and the script itself is a
     no-op unless the "R2-D2" flash drive specifically is what appeared.
     Keeps .pptx + PDF exports of every course's Keynote (.key) lecture
     decks under ~/Documents/Classes/Slides current on that drive, since
     the lecture hall computers only have PowerPoint. Courses are
     auto-discovered from that folder (see sync_slides_drive.sh's own
     header comment); there's no per-course list to maintain here. See
     ~/Documents/Classes/Slides/theme-system/README.txt for the full
     normalization workflow this supports.

     ProgramArguments launches ~/Applications/DeckSync.app's own compiled
     binary directly, NOT /bin/bash -- ~/Documents and the drive itself
     (a removable volume) are both under macOS's TCC folder protections,
     so a background agent touching them needs to be a permission-checked
     app, not a bare interpreter. Granting broad access to /bin/bash
     itself would hand that same access to every shell script on the
     system; DeckSync.app is a thin `do shell script` wrapper around this
     exact script (source: keynote/DeckSync.applescript in this repo)
     that exists so the grant is scoped to just this one app instead.
     `do shell script` is one of the patterns TCC attributes to the
     calling app rather than to /bin/sh, which is what makes the scoping
     work. In practice this surfaced as two one-time "DeckSync would like
     to access files in your Documents folder / on a removable volume"
     prompts (confirmed via `launchctl kickstart`, the same invocation
     WatchPaths uses) -- narrower than Full Disk Access, and sufficient,
     since those are the only two locations this script ever touches.
     If DeckSync.app is ever rebuilt, expect both prompts to reappear --
     TCC grants are tied to the app's signature, which osacompile
     regenerates on every build. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.jaredeberle.decksync</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/DeckSync.app/Contents/MacOS/applet</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>/Volumes</string>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/deck-sync-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/deck-sync-launchd.log</string>
</dict>
</plist>
