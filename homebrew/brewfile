# Dependences and settings
cask_args appdir: "/Applications" # install GUI casks into /Applications

brew "mas" # Mac App Store CLI (installs the `mas` entries below)

# Languages
brew "bash" # Modern bash (macOS ships 3.2; 4+ needed for mapfile, etc.)
brew "lua" # Lua interpreter
brew "node" # Node.js runtime (also powers prettier, bash-language-server)

# Language tools
brew "uv" # runs bin/ python scripts via inline PEP 723 deps

# Neovim LSPs, formatters, linters (referenced by nvim/lua/plugins/*)
brew "bash-language-server" # bashls
brew "black"              # python formatter (conform)
brew "harper"             # grammar LSP for markdown (harper_ls; vale covers style, vim spell covers spelling)
brew "lua-language-server" # lua_ls
brew "luacheck"           # Lua linter (CI lint workflow)
brew "shellcheck"         # shell-script linter (CI lint workflow; bin/ scripts)
brew "marksman"           # markdown LSP (cross-document links/headings navigation)
brew "prettier"           # markdown formatter (conform)
brew "pyright"             # python LSP
brew "stylua"             # lua formatter (conform)
brew "tree-sitter-cli"    # parser generator CLI (nvim-treesitter main branch builds parsers with it)
brew "vale"               # prose linter (nvim-lint)

# CLI tools
brew "bat" # cat clone with syntax highlighting (aliased to `cat`)
brew "btop" # resource monitor with a clean terminal UI
brew "coreutils" # GNU core utilities (provides dircolors for LS_COLORS)
brew "curl" # data transfer / HTTP client
brew "eza" # modern ls replacement (aliased to ls/ll/la/lt)
brew "fd" # fast find replacement (used by fzf and findd/findf)
brew "fish"   # primary shell (config in fish/)
brew "fzf" # fuzzy finder (Ctrl-R/Ctrl-T/Alt-C keybindings)
brew "gh" # GitHub CLI (used by the depmerge function)
brew "ghostscript" # PostScript/PDF engine (CV, syllabi PDF builds; website image processing)
brew "git" # version control
brew "git-delta" # diff pager (used by git and lazygit)
brew "gitleaks" # secret scanner (global git pre-commit hook; see git/hooks/pre-commit)
brew "gitup" # update multiple repos at once
brew "gnupg" # GPG encryption / key management
brew "hugo" # static site generator
brew "imagemagick" # image conversion (website to-avif.sh)
brew "isync" # IMAP sync to local Maildir (mbsync; config in writing/neomutt/mbsyncrc)
brew "lazygit" # terminal git UI (aliased to lg)
brew "lychee" # fast link checker (markdown/prose)
brew "mole" # deep clean and optimize macOS
brew "neomutt" # terminal email client (config in writing/neomutt/)
brew "notmuch" # mail indexer for fast search (used by NeoMutt virtual mailboxes)
brew "pam-reattach" # lets pam_tid.so (Touch ID for sudo) work inside tmux; see `make touchid`
brew "neovim" # text editor (config in nvim/)
brew "ocrmypdf" # OCR layer for scanned archival PDFs before Zotero/Obsidian full-text indexing (Archives workflow Step 1)
brew "pandoc" # document converter (prose/Pandoc export workflow)
brew "pandoc-crossref" # Pandoc filter for figure/table/equation cross-references
brew "pinentry-mac" # GPG passphrase prompt on macOS
brew "poppler" # PDF text/image extraction (pdftotext, pdfinfo, pdftoppm for the Zotero OCR plugin; complements qpdf)
brew "qpdf" # PDF transformation (CV, syllabi PDF builds; pdfpages/pdfmerge functions)
brew "restic" # encrypted, deduplicated, snapshotted backups (archival scans → external HD; used by archbackup)
brew "ripgrep" # fast recursive search (used by Telescope in nvim)
brew "ripgrep-all" # ripgrep wrapper that searches inside PDFs/etc. via poppler (rga; used by the archgrep function for OCR'd archival scans)
brew "tectonic" # LaTeX engine for all PDF builds (pandoc defaults.yaml, CV, syllabi); auto-fetches packages
brew "tesseract" # OCR engine (Zotero OCR plugin + Zotero connector image OCR; backs ocrmypdf)
brew "tmux" # terminal multiplexer (config shell/tmux.conf)
brew "urlscan" # extract and open URLs from emails (used by NeoMutt \Cu macro)
brew "w3m" # terminal browser; renders HTML emails inline in NeoMutt
brew "zoxide" # smarter cd via frecency (the `z` command)

