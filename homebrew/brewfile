# Dependences and settings
cask_args appdir: "/Applications" # install GUI casks into /Applications

brew "mas" # Mac App Store CLI (installs the `mas` entries below)

# Languages
brew "bash" # Modern bash (macOS ships 3.2; 4+ needed for mapfile, etc.)
brew "lua" # Lua interpreter
brew "node" # Node.js runtime (also powers prettier, bash-language-server)
cask "r-app" # R statistical computing language

# Language tools
brew "pyenv" # Python version manager
brew "rbenv" # Ruby version manager
brew "uv" # runs bin/ python scripts via inline PEP 723 deps

# Neovim LSPs, formatters, linters (referenced by nvim/lua/plugins/*)
brew "bash-language-server" # bashls
brew "black"              # python formatter (conform)
brew "lua-language-server" # lua_ls
brew "luacheck"           # Lua linter (CI lint workflow)
brew "prettier"           # markdown formatter (conform)
brew "pyright"             # python LSP
brew "stylua"             # lua formatter (conform)
brew "tree-sitter-cli"    # parser generator CLI (nvim-treesitter main branch builds parsers with it)
brew "vale"               # prose linter (nvim-lint)

# CLI tools
brew "bat" # cat clone with syntax highlighting (aliased to `cat`)
brew "coreutils" # GNU core utilities (provides dircolors for LS_COLORS)
brew "curl" # data transfer / HTTP client
brew "exiftool" # media metadata (read/write)
brew "eza" # modern ls replacement (aliased to ls/ll/la/lt)
brew "fd" # fast find replacement (used by fzf and findd/findf)
brew "ffmpeg" # audio/video transcoding
brew "fish"   # primary shell (config in fish/)
brew "fzf" # fuzzy finder (Ctrl-R/Ctrl-T/Alt-C keybindings)
brew "ghostscript" # PostScript/PDF engine
brew "gibo" # Sensible .gitignore defaults
brew "git" # version jontrol
brew "git-delta" # Used in combination with lazygit
brew "git-lfs" # Versioning large files
brew "gitup" # Update multiple repos at once
brew "gnupg" # GPG encryption / key management
brew "hugo" # static site generator
brew "imagemagick" # image conversion / manipulation
brew "lazygit" # terminal git UI (aliased to lg)
brew "lychee" # fast link checker (markdown/prose)
brew "neovim" # text editor (config in nvim/)
brew "ocrmypdf" #OCR software
brew "pandoc" # document converter (prose/Pandoc export workflow)
brew "pandoc-crossref" # Pandoc filter for figure/table/equation cross-references
brew "pinentry-mac" # GPG passphrase prompt on macOS
brew "pipx" # isolated Python CLI installs
brew "qpdf" # PDF transformation
brew "ripgrep" # fast recursive search (used by Telescope in nvim)
brew "tmux" # terminal multiplexer (config general/tmux.conf)
brew "wget" # file downloader
brew "zoxide" # smarter cd via frecency (the `z` command)

