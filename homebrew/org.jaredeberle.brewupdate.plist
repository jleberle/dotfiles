<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: __HOME__ is replaced with $(HOME) by `make brewauto`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.jaredeberle.brewupdate</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.dotfiles/bin/homebrewupdate.sh</string>
    </array>

    <!-- Monday 09:00; runs on next wake if the Mac was asleep. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>1</integer>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <!-- The script manages its own log (~/.local/brew_update_logs.txt), prepending each run. -->
</dict>
</plist>
