<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: __HOME__ is replaced with $(HOME) by `make brewauto`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.jaredeberle.brewupdate</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/git/dotfiles/bin/homebrewupdate.sh</string>
    </array>

    <!-- Monday 09:00; runs on next wake if the Mac was asleep. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>1</integer>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <!-- Background: this is a heavy, unattended job that competes with whatever
         you are actually doing at the moment it fires. ProcessType Background
         puts it in launchd's throttled band -- low CPU priority AND throttled
         disk I/O -- which is what separates "runs weekly" from "makes the
         machine feel broken for ten minutes every Monday morning". No `Nice`
         key alongside it: ProcessType already sets scheduling priority, and the
         two disagreeing is how you get a job that is nice-19 but still saturates
         the disk. Deliberately NOT set on mailsync (it must finish inside its
         five-minute interval) or decksync (you are standing at the machine
         waiting for the export when it fires). -->
    <key>ProcessType</key>
    <string>Background</string>

    <!-- The script manages its own log (~/.local/brew_update_logs.txt), prepending each run. -->
</dict>
</plist>
