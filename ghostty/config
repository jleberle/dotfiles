# -----------------------------
# Appearance
# -----------------------------

theme = Catppuccin Mocha

font-family = "JetBrainsMono Nerd Font Mono"
font-size = 15

window-padding-x = 12
window-padding-y = 12

background-opacity = 0.93
background-blur-radius = 18

shell-integration = zsh

copy-on-select = true

gtk-single-instance = true

# -----------------------------
# macOS / nvim / tmux usability
# -----------------------------

# Send Option as Alt/Meta so tmux's M-h / M-l window switches and nvim
# Alt-mappings work instead of inserting accented characters.
macos-option-as-alt = true

copy-on-select = clipboard
mouse-hide-while-typing = true

cursor-style-blink = false

# Restore window layout/working dirs after a restart
window-save-state = always

# -----------------------------
# Shell Integration
# -----------------------------

# Valid value is a feature list (not a boolean). cursor + title keep the
# prompt/cursor reporting that starship and nvim rely on; sudo preserves
# integration across sudo sessions.
shell-integration-features = cursor,sudo,title
