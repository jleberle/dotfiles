[user]
	name = Jared Eberle
	email = jared@jaredeberle.org
	signingkey = 17904CDD2FA1441662D0CCD1E0646B558C79DB58

[gpg]
	format = openpgp

[commit]
	gpgsign = true
	verbose = true
	template = ~/.gitmessage

[tag]
	gpgsign = true
	sort = version:refname

[github]
	user = jleberle

[alias]
	amend = commit --amend
	undo = reset --soft HEAD~1
	last = log -1 HEAD
	lg = log --graph --pretty=format:'%C(yellow)%h%Creset %C(cyan)%ad%Creset %Cgreen[%an]%Creset %s %C(auto)%d%Creset' --date=short
	lol = log --graph --decorate --oneline --all
	unstage = restore --staged
	discard = restore
	# Word-level diff for prose — shows the changed words, not changed lines
	wdiff = diff --word-diff=color

[color]
	ui = auto

[core]
	editor = nvim
	autocrlf = input
	excludesfile = ~/.gitignore
	pager = delta
	# Run the tracked hooks (gitleaks secret scan) in every repo. NOTE: this is
	# global — a repo that sets its own core.hooksPath (e.g. husky) overrides it,
	# so the secret scan won't run there; conversely it supersedes any per-repo
	# .git/hooks. See git/hooks/pre-commit.
	hooksPath = ~/.dotfiles/git/hooks

# Reject malformed/malicious objects on fetch, clone, and (local) receive —
# defense against object-confusion and known git-parsing CVEs. Downside: refuses
# to clone the rare older repo containing historically-malformed objects; turn
# fetch.fsckObjects off temporarily if you ever hit a legitimately broken remote.
[transfer]
	fsckObjects = true
[fetch]
	fsckObjects = true
	prune = true
[receive]
	fsckObjects = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	syntax-theme = Nord

[apply]
	whitespace = fix

[merge]
	tool = nvimdiff
	conflictstyle = zdiff3

[mergetool]
	keepBackup = false

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = current

[diff]
	colorMoved = default
	algorithm = histogram

[rebase]
	autoStash = true
	updateRefs = true

[rerere]
	enabled = true

[help]
	autocorrect = prompt

[init]
	defaultBranch = main

[branch]
	sort = -committerdate
