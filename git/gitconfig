[user]
	name = Jared Eberle
	email = jared@jaredeberle.org
	signingkey = 17904CDD2FA1441662D0CCD1E0646B558C79DB58

[gpg]
	format = openpgp

[commit]
	gpgsign = true
	verbose = true

[tag]
	gpgsign = true
	sort = version:refname

[github]
	user = jleberle

[alias]
	amend = commit --amend
	undo = reset --soft HEAD~1
	last = log -1 HEAD
	lg = log --graph --pretty=format:'%C(yellow)%h%Creset %C(cyan)%ad%Creset %Cgreen[%an]%Creset %s %C(auto)%d%Creset' --date=short
	lol = log --graph --decorate --oneline --all
	unstage = restore --staged
	discard = restore

[color]
	ui = auto

[core]
	editor = nvim
	autocrlf = input
	excludesfile = ~/.gitignore
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	syntax-theme = Catppuccin Mocha

[apply]
	whitespace = fix

[merge]
	tool = nvimdiff
	conflictstyle = zdiff3

[mergetool]
	keepBackup = false

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = current

[diff]
	colorMoved = default
	algorithm = histogram

[rebase]
	autoStash = true
	updateRefs = true

[fetch]
	prune = true

[rerere]
	enabled = true

[help]
	autocorrect = prompt

[init]
	defaultBranch = main

[branch]
	sort = -committerdate
