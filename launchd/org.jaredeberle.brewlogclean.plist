<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: __HOME__ is replaced with $(HOME) by `make brewauto`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.jaredeberle.brewlogclean</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.dotfiles/bin/homebrewlogclean.sh</string>
    </array>

    <!-- Monday 08:00 (before the update); the script itself gates to the
         first Monday of the month, so a weekly trigger is fine. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>1</integer>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
</dict>
</plist>
