[user]
    name = Jared Eberle
	email = jared@jaredeberle.org
	signingkey = ~/.ssh/id_ed25519

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.dotfiles/Git/allowed_signers
	
[commit]
	gpgsign = true
	
[tag]
	gpgsign = true
		
[github]
    user = jleberle

[alias]
   st = status -sb
    co = checkout
    cb = checkout -b
    br = branch
    ci = commit
    amend = commit --amend
    undo = reset --soft HEAD~1
    last = log -1 HEAD
    lg = log --graph --pretty=format:'%C(yellow)%h%Creset %C(cyan)%ad%Creset %Cgreen[%an]%Creset %s %C(auto)%d%Creset' --date=short
    lol = log --graph --decorate --oneline --all
    unstage = restore --staged
    discard = restore

[color]
    ui = auto
    
[core]
    editor = nvim
    autocrlf = input
    excludesfile = ~/.gitignore
    pager = delta

[apply]
    whitespace = fix

[merge]
    tool = vimdiff

[mergetool]
    keepBackup = false

[help]
    autocorrect = 1

[pull]
	rebase = true

[push]
    autoSetupRemote = true
    default = current
    
[diff]
    colorMoved = default

[rebase]
    autoStash = true

[merge]
    conflictstyle = zdiff3

[fetch]
    prune = true

[color]
    ui = auto

[rerere]
    enabled = true

[help]
    autocorrect = prompt
	
[init]
	defaultBranch = main
