# -----------------------------
# Appearance
# -----------------------------

theme = Nord

font-family = "JetBrainsMono Nerd Font Mono"
font-size = 15

window-padding-x = 12
window-padding-y = 12

background-opacity = 0.93
background-blur-radius = 18

shell-integration = fish

# -----------------------------
# macOS / nvim / tmux usability
# -----------------------------

# Send left Option as Alt/Meta so tmux's M-h / M-l window switches and nvim
# Alt-mappings work. Right Option is left as-is for macOS accented characters
# (é, ü, ñ, etc.).
macos-option-as-alt = left

copy-on-select = clipboard
mouse-hide-while-typing = true

cursor-style-blink = false

# Restore window layout/working dirs after a restart
window-save-state = always

# -----------------------------
# Shell Integration
# -----------------------------

# Valid value is a feature list (not a boolean). cursor + title keep the
# prompt/cursor reporting that the fish prompt and nvim rely on; sudo preserves
# integration across sudo sessions.
shell-integration-features = cursor,sudo,title
