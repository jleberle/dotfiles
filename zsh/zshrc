# ------------------------------------------------------------------------------
# History
# ------------------------------------------------------------------------------

HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt INC_APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_VERIFY 
setopt HIST_FIND_NO_DUPS

# Expire duplicate entries first when trimming history
setopt HIST_EXPIRE_DUPS_FIRST

# ------------------------------------------------------------------------------
# Shell Behavior
# ------------------------------------------------------------------------------

setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_MINUS
setopt INTERACTIVE_COMMENTS

# Prevent accidental file overwrite with >
setopt NO_CLOBBER

# Better globbing behavior
setopt EXTENDED_GLOB

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------

# XDG-style cache location
export ZSH_CACHE_DIR="$HOME/.cache/zsh"
[[ -d "$ZSH_CACHE_DIR" ]] || mkdir -p "$ZSH_CACHE_DIR"

# Apple Silicon Homebrew prefix
BREW_PREFIX="/opt/homebrew"

# Colors for the completion menu (consumed by the list-colors zstyle below).
# Use GNU dircolors if available, otherwise a sane built-in default.
# Note: eza also honors LS_COLORS, so this affects its output too.
if (( $+commands[dircolors] )); then
  export LS_COLORS="$(dircolors -b)"
else
  export LS_COLORS='di=34:ln=35:so=32:pi=33:ex=31:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=34;42'
fi

# ------------------------------------------------------------------------------
# Completion System
# ------------------------------------------------------------------------------
fpath=(
  "$HOME/.dotfiles/zsh/functions"
  $fpath
)

# Single compinit call; skip security check if dump is fresh (< 24h old)
autoload -Uz compinit
zcompdump="$ZSH_CACHE_DIR/.zcompdump"
if [[ -n "$zcompdump"(#qN.mh-24) ]]; then
  compinit -C -d "$zcompdump"
else
  compinit -d "$zcompdump"
fi
unset zcompdump

# Register user functions for autoload (lazy: bodies are only sourced on first call)
autoload -Uz "$HOME/.dotfiles/zsh/functions/"*(:t)

# Completion styling
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Completion caching
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$ZSH_CACHE_DIR"

# Better completion grouping
zstyle ':completion:*' group-name ''

# Enable descriptions in completion menu
zstyle ':completion:*:descriptions' format '[%d]'

# ------------------------------------------------------------------------------
# Keybindings
# ------------------------------------------------------------------------------

bindkey -e

# Ctrl + Left/Right Arrow = move by word
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word

# History search with arrows
autoload -Uz up-line-or-beginning-search
autoload -Uz down-line-or-beginning-search

zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# ------------------------------------------------------------------------------
# FZF
# ------------------------------------------------------------------------------

# Cache `fzf --zsh` output; rebuild if the fzf binary is newer than the cache.
fzf_cache="$ZSH_CACHE_DIR/fzf.zsh"
fzf_bin="$BREW_PREFIX/bin/fzf"
if [[ ! -s "$fzf_cache" || "$fzf_bin" -nt "$fzf_cache" ]]; then
  "$fzf_bin" --zsh >| "$fzf_cache"
fi
source "$fzf_cache"
unset fzf_cache fzf_bin

# Use fd for faster searching
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# Better previews
export FZF_CTRL_T_OPTS="
  --preview 'bat --color=always --style=numbers --line-range=:500 {}'
"

# ------------------------------------------------------------------------------
# Zoxide
# ------------------------------------------------------------------------------

# Cache `zoxide init zsh`; rebuild if the zoxide binary is newer than the cache.
zoxide_cache="$ZSH_CACHE_DIR/zoxide.zsh"
zoxide_bin="$BREW_PREFIX/bin/zoxide"
if [[ ! -s "$zoxide_cache" || "$zoxide_bin" -nt "$zoxide_cache" ]]; then
  "$zoxide_bin" init zsh >| "$zoxide_cache"
fi
source "$zoxide_cache"
unset zoxide_cache zoxide_bin

# ------------------------------------------------------------------------------
# Plugins
# ------------------------------------------------------------------------------

# Source each plugin only if present, so a missing/uninstalled plugin
# doesn't throw errors on startup. Syntax highlighting must stay last.
for plugin in \
  zsh-autosuggestions/zsh-autosuggestions.zsh \
  zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
  [[ -r "$BREW_PREFIX/share/$plugin" ]] && source "$BREW_PREFIX/share/$plugin"
done
unset plugin

# ------------------------------------------------------------------------------
# Aliases
# ------------------------------------------------------------------------------

source "$HOME/.dotfiles/zsh/aliases.zsh"

# ------------------------------------------------------------------------------
# Prompt
# ------------------------------------------------------------------------------

# Cache `starship init zsh`; rebuild if the binary is newer than the cache.
starship_cache="$ZSH_CACHE_DIR/starship.zsh"
starship_bin="$BREW_PREFIX/bin/starship"
if [[ ! -s "$starship_cache" || "$starship_bin" -nt "$starship_cache" ]]; then
  "$starship_bin" init zsh >| "$starship_cache"
fi
source "$starship_cache"
unset starship_cache starship_bin
